{
  "name": "godspeed-quick-add",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Send the current Obsidian note to Godspeed as a task",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test \"test/*.test.ts\"",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "typescript": "^5.6.0"
  }
}
